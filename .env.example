# Traffic Intel Environment Configuration
# Copy this file to .env and fill in your own API keys.
# Never commit your .env file or real API keys to version control.

# Live Traffic Data Provider: "tomtom", "here", or "none"
TRAFFIC_PROVIDER=none

# TomTom Traffic Flow & Incidents API Key (https://developer.tomtom.com/)
TOMTOM_API_KEY=

# HERE Traffic API Key (https://developer.here.com/)
HERE_API_KEY=

# Default Map Center Coordinates (Latitude, Longitude)
DEFAULT_MAP_LAT=28.6139
DEFAULT_MAP_LON=77.2090
